[Unit]
Description=Dispara a atualizacao automatica quando as listas do apt mudam
# "apt-get update" (rodado pelo apt-daily e pela propria cadeia) reescreve
# dezenas/centenas de arquivos de lista de uma vez. Com o limite padrao do
# systemd (5 starts em 10s) o unit morria; desabilite o limite porque cada
# disparo extra e um no-op barato do debounce no wrapper.
StartLimitIntervalSec=0
StartLimitBurst=1000

[Path]
PathChanged=/var/lib/apt/lists
Unit=auto-upgrade.service

[Install]
WantedBy=multi-user.target
